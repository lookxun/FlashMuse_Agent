# ============ 供应商密钥 ============
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5

# BytePlus（火山方舟，生图/生视频主力 + 素材审核）
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=
# 各生成端点偏好（JSON，后台「系统设置」页可改，改动写回 .env.local）
MODEL_PROVIDER_PREFERENCES=

# Seedance 独立聚合接口当前本地 MVP 暂停使用，后续部署服务器加白后再配置。
SEEDANCE_BASE_URL=
SEEDANCE_PROJECT_CODE=
SEEDANCE_ACCESS_KEY=
SEEDANCE_SECRET_KEY=

# ============ 数据库 ============
# 本地 Docker PostgreSQL 默认连接串；正式部署时换成线上数据库连接串。
# ⭐ 连接池参数（M023）：多项目共用机器，显式给 connection_limit + pool_timeout。
DATABASE_URL="postgresql://flashmuse:flashmuse_dev_password@localhost:5432/flashmuse?schema=public&connection_limit=25&pool_timeout=20"
# docker-compose 用的数据库密码（服务器 /opt/flashmuse/.env 与 /opt/flashmuse-staging/.env，不进 git）
FLASHMUSE_DB_PASSWORD=
FLASHMUSE_STAGING_DB_PASSWORD=

# ============ 登录 / 会话 ============
# 登录 Cookie / 验证码哈希密钥。⭐ 生产必须配置（不配会直接启动失败，见 src/lib/auth-secret.ts）。
AUTH_SECRET=
# 后台管理员邮箱白名单，多个邮箱用英文逗号分隔。
ADMIN_EMAILS=
# 跨子域名共享 cookie 时才需要（一般留空）
AUTH_COOKIE_DOMAIN=
# 本地 http 调试时允许非 Secure cookie
FORCE_INSECURE_AUTH_COOKIE=false

# ============ SMTP（邮箱验证码）============
# 网易 163 示例：smtp.163.com / 465 / true。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============ 站点地址（构建期内联，改了要重新 build）============
NEXT_PUBLIC_STATIC_BASE_URL=
NEXT_PUBLIC_UPLOAD_BASE_URL=
NEXT_PUBLIC_PRIMARY_BASE_URL=
NEXT_PUBLIC_WORKFLOW_MODE_ENABLED=true
NEXT_PUBLIC_IS_TEST=
NEXT_PUBLIC_ENABLE_BYTEPLUS_ASSET_REVIEW=true

# 上传接口额外的 CORS 白名单（逗号分隔；默认已含主站各域名）
UPLOAD_CORS_ORIGINS=

# ============ 阿里静态镜像同步（deploy/sync-ali.sh / src/lib/ali-sync.ts）============
ALI_SYNC_HOST=101.37.129.164
ALI_SYNC_USER=root
ALI_SYNC_SSH_KEY=
ALI_SYNC_PORT=22

# 已发布版本号（compose 注入；部署最后一步才 set，见 handover/03）
PUBLISHED_APP_VERSION=
