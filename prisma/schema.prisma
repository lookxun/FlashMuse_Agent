generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String    @id
  email                      String    @unique
  passwordHash               String?
  nickname                   String?
  phone                      String?
  avatarUrl                  String?
  language                   String    @default("简体中文")
  notifyOnGenerationComplete Boolean   @default(true)
  autoSaveHistory            Boolean   @default(true)
  previewWheelZoom           Boolean   @default(true)
  previewWheelFlip           Boolean   @default(true)
  credits                    Int       @default(1500)
  textCreditRemainder        Float     @default(0)
  disabled                   Boolean   @default(false)
  generalModeEnabled         Boolean   @default(false)
  // 「解除限制」按账号开关：开 = 发给 BytePlus 的 model 用我们的专属 Endpoint ID（平台策略更宽），
  // 关 = 发公开模型名。历史上这是 .env.local 里的全局开关 BYTEPLUS_UNLOCK_LIMITS，
  // 2026-07-30 改成按账号；全局那个只留作"没传按账号值时"的回落，后台入口已移到「帐号功能管理」。
  unlockLimitsEnabled        Boolean   @default(false)
  generatedImageCount        Int       @default(0)
  generatedVideoCount        Int       @default(0)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  lastLoginAt                DateTime?
  lastLoginIp                String?
  lastLoginLocation          String?
  lastLoginUserAgent         String?
  sessions                   Session[]
  workspaceSessions          WorkspaceSession[]
  workspaceMessages          WorkspaceMessage[]
  workspaceWorkflows         WorkspaceWorkflow[]
  workspace                  UserWorkspaceState?
  creditLedgers              CreditLedger[]
  mediaAssets                MediaAsset[]
  userAssetStates            UserAssetState[]
  gptImagePromptOptimizationCases GptImagePromptOptimizationCase[]
}

model CreditSetting {
  id                    String   @id @default("default")
  usdToCnyRate          Float    @default(7.2)
  creditsPerCny         Int      @default(10)
  signupCredits         Int      @default(0)
  chargeText            Boolean  @default(true)
  chargeImage           Boolean  @default(true)
  chargeVideo           Boolean  @default(true)
  chargePromptTool      Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model CreditLedger {
  id               String   @id @default(cuid())
  userId           String
  conversationId   String?
  conversationTitle String?
  workspaceKind    String?
  workspaceId      String?
  requestId        String?
  direction        String   @default("consume")
  kind             String
  label            String?
  model            String?
  credits          Int
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  usd              Float    @default(0)
  cny              Float    @default(0)
  imageCount       Int      @default(0)
  videoCount       Int      @default(0)
  metadata         Json?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([direction, createdAt])
  @@index([conversationId])
  @@index([workspaceKind, workspaceId])
  @@index([userId, direction, workspaceKind, workspaceId])
  @@index([userId, direction, conversationId])
  @@unique([requestId, kind])
}

model UserWorkspaceState {
  id        String   @id @default(cuid())
  userId    String   @unique
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id                   String   @id @default(cuid())
  userId               String
  mediaType            String
  url                  String
  normalizedUrl        String
  posterUrl            String?
  thumbnailUrl         String?
  originalUrl          String?
  storagePath          String?
  width                Int?
  height               Int?
  durationSeconds      Float?
  mimeType             String?
  fileSize             Int?
  sourceKind           String
  sourceDetail         String?
  sourcePrompt         String?
  promptSource         String?
  reversePrompt        String?
  model                String?
  modelProvider        String?
  ratio                String?
  resolution           String?
  imageSize            String?
  videoDuration        String?
  generationSettings   Json?
  previewMeta          Json?
  originalFileName     String?
  contentHash          String?
  systemName           String?
  initialName          String?
  initialCategory      String?
  creditLedgerId       String?
  costSource           String?
  chargedUsd           Float    @default(0)
  chargedCny           Float    @default(0)
  chargedCredits       Float    @default(0)
  promptTokens         Float    @default(0)
  completionTokens     Float    @default(0)
  totalTokens          Float    @default(0)
  costShareCount       Int?
  costShareIndex       Int?
  requestId            String?
  conversationId       String?
  messageId            String?
  workflowId           String?
  workflowNodeId       String?
  workspaceKind        String?
  workspaceId          String?
  legacyAssetId        String?
  legacyLibrarySource  String?
  archivedAt           DateTime?
  archiveReason        String?
  duplicateOfMediaAssetId String?
  firstSeenAt          DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userStates           UserAssetState[]

  @@unique([userId, normalizedUrl])
  @@index([userId, mediaType, createdAt])
  @@index([userId, sourceKind, createdAt])
  @@index([creditLedgerId])
  @@index([requestId])
  @@index([conversationId])
  @@index([messageId])
  @@index([workflowId])
  @@index([userId, workspaceKind, createdAt])
  @@index([userId, archivedAt])
  @@index([userId, contentHash])
  @@index([userId, systemName])
  @@index([userId, url])
  @@index([userId, firstSeenAt])
}

model UserAssetState {
  id                 String   @id @default(cuid())
  userId             String
  mediaAssetId       String
  currentName        String?
  currentCategory    String
  originalCategory   String?
  previousCategory   String?
  userRenamed        Boolean  @default(false)
  userRecategorized  Boolean  @default(false)
  lockedCategory     Boolean  @default(false)
  sortOrder          Int?
  deletedAt          DateTime?
  purgeAt            DateTime?
  restoredAt         DateTime?
  bytePlusAssetId    String?
  bytePlusAssetGroupId String?
  bytePlusAssetStatus String?
  bytePlusAssetError String?
  bytePlusAssetUpdatedAt DateTime?
  hiddenAt           DateTime?
  hiddenReason       String?
  legacyAssetJson    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset         MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaAssetId])
  @@index([mediaAssetId])
  @@index([userId, currentCategory, deletedAt, sortOrder])
  @@index([userId, deletedAt, updatedAt])
  @@index([userId, hiddenAt])
}

model GptImagePromptOptimizationCase {
  id              String   @id @default(cuid())
  userId          String
  workflowId      String?
  workflowNodeId  String?
  mediaAssetId    String?
  imageUrl        String
  thumbnailUrl    String?
  sourceModel     String
  optimizerModel  String
  attemptsUsed    Int
  originalPrompt  String
  optimizedPrompt String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([workflowId])
  @@index([workflowNodeId])
  @@index([mediaAssetId])
  @@index([sourceModel, createdAt])
}

model WorkspaceSession {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String
  workspaceKind String   @default("conversation")
  title         String
  updatedAt     DateTime
  messagesJson  Json
  summaryJson   Json?
  usageSummary  Json?
  memorySummary Json?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  storedAt      DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([workspaceKind])
  @@index([userId, updatedAt])
  @@index([userId, deletedAt, updatedAt])
}

model WorkspaceWorkflow {
  id            String   @id @default(cuid())
  userId        String
  workflowId    String
  workflowCode  String?
  workspaceKind String   @default("workflow")
  title         String
  nextImageNumber Int    @default(1)
  nextVideoNumber Int    @default(1)
  updatedAt     DateTime
  canvasJson    Json
  usageSummary  Json?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  storedAt      DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workflowId])
  @@index([workspaceKind])
  @@index([userId, updatedAt])
  @@index([userId, deletedAt, updatedAt])
}

model WorkspaceMessage {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  messageId   String
  role        String
  content     String
  createdAt   DateTime
  messageJson Json
  storedAt    DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId, messageId])
  @@index([userId, sessionId, createdAt])
  @@index([userId, createdAt])
}

model GenerationEvent {
  id                  String   @id @default(cuid())
  userId              String?
  requestId           String?
  kind                String
  source              String   @default("conversation")
  model               String?
  provider            String?
  status              String
  failureReason       String?
  failureCode         String?
  moderation          Boolean  @default(false)
  durationMs          Int?
  referenceImageCount Int      @default(0)
  referenceVideoCount Int      @default(0)
  referenceAudioCount Int      @default(0)
  createdAt           DateTime @default(now())
  // 失败原因「已归档」标记：根因已经查清并修掉/堵上后，把对应事件归档。
  // 后台「失败原因」里归档的那部分不再计入待处理数量，而是划掉展示（文字保留、可追溯）。
  // 错误编号 B_xxx 计数器与此无关，继续自增。
  resolvedAt          DateTime?
  resolvedNote        String?

  @@unique([requestId, kind])
  @@index([createdAt])
  @@index([kind, status, createdAt])
  @@index([model, createdAt])
  @@index([source, createdAt])
  @@index([status, resolvedAt])
}

model UploadEvent {
  id        String   @id @default(cuid())
  userId    String?
  kind      String   @default("image")
  status    String
  reason    String?
  bytes     Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status, createdAt])
}

model ContentModerationRuleGroup {
  id        String   @id @default(cuid())
  category  String   @unique
  label     String
  enabled   Boolean  @default(false)
  termsHidden Boolean @default(false)
  editUnlocked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  terms     ContentModerationTerm[]

  @@index([enabled])
}

model ContentModerationTerm {
  id        String   @id @default(cuid())
  groupId   String
  value     String
  normalized String
  createdAt DateTime @default(now())
  group     ContentModerationRuleGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, normalized])
  @@index([groupId])
}

model ContentModerationEvent {
  id             String   @id @default(cuid())
  userId         String?
  requestId      String?
  kind           String
  source         String
  category       String
  action         String
  status         String
  prompt         String
  matchedTerm    String?
  semanticReason String?
  reviewedAt     DateTime?
  leaseAt        DateTime?
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
  @@index([requestId])
}

// 顶部公告横幅：全局只有一条（用固定 key 单行 upsert，照内容审核那套范式）。
// content 为空或 enabled=false 时前端不显示。version 由内容 hash 在读取接口现算，
// 用户点 × 关闭后按 version 记进 localStorage，后台改文案后 version 变化会重新弹给所有人。
model Announcement {
  id           String   @id @default(cuid())
  key          String   @unique @default("global")
  content      String   @default("")
  enabled      Boolean  @default(false)
  currentRunId String?
  updatedAt    DateTime @updatedAt
}

// 记录"某用户关闭了某个 version 的公告"，按 (userId, version) 去重。
// 后台统计当前公告 version 的关闭人数用；改文案后 version 变，旧记录不再计入。
model AnnouncementDismissal {
  id        String   @id @default(cuid())
  userId    String
  version   String
  createdAt DateTime @default(now())

  @@unique([userId, version])
  @@index([version])
}

// 公告发布历史：每次"开启开关"记一条（createdAt = 开启时刻，不去重）。
// 后台历史表用它 + 按 version 关联 AnnouncementDismissal 统计各条公告的关闭数量。
model AnnouncementHistory {
  id        String   @id @default(cuid())
  version   String
  content   String
  createdAt DateTime @default(now())

  @@index([version])
  @@index([createdAt])
}

model GenerationJob {
  id                String    @id @default(cuid())
  userId            String
  requestId         String    @unique
  kind              String
  status            String    @default("queued")
  flow              String?
  creditSource      String?
  model             String?
  provider          String?
  prompt            String?
  settingsJson      Json?
  referenceImages   Json?
  referenceVideos   Json?
  referenceAudios   Json?
  referenceNames    Json?
  referenceMode     String?
  conversationId    String?
  conversationTitle String?
  messageId         String?
  workflowId        String?
  workflowNodeId    String?
  itemIndex         Int?
  count             Int       @default(1)
  providerTaskId    String?
  reservedNames     Json?
  resultUrls        Json?
  resultDimensions  Json?
  posterUrl         String?
  usageJson         Json?
  creditJson        Json?
  metadataJson      Json?
  extraJson         Json?
  error             String?
  errorCode         String?
  attempts          Int       @default(0)
  leaseAt           DateTime?
  nextRunAt         DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([status, kind, nextRunAt])
  @@index([userId, status, updatedAt])
  @@index([workflowId])
  @@index([conversationId])
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  activeWorkspaceInstanceId String?
  activeWorkspaceSeenAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([lastSeenAt])
}
